<?js
	var data = obj;
	const escapeHTML = str => str.replace(/[&<>'"]/g, 
		tag => ({
			'&': '&amp;',
			'<': '&lt;',
			'>': '&gt;',
			"'": '&#39;',
			'"': '&quot;'
			}[tag]));

    data.forEach(function(example) {
        if (example.caption) {
    ?>
        <p class="code-caption"><?js= example.caption ?></p>
    <?js } ?>

    <?js if (example.code.toString().indexOf('<pre>') === -1) { ?>
    <pre class="prettyprint"><code><?js= escapeHTML(example.code) ?></code></pre>
    <?js } else { ?>
    <?js= escapeHTML(example.code.replace(/<pre>/g, '<pre class="prettyprint">')) ?>
    <?js } ?>
<?js
    });
?>