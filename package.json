{
	"name": "ocwpexample",
	"version": "3.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"docs:api": "node ./jsdoc/docsApi.js",
		"docs": "jsdoc -c jsdoc.json && npm run docs:api",
		"lint": "eslint cli deploy packages/ocwp-core/src packages/ocwp-components/src",
		"test": "cd packages/ocwp-core && npm run test",
		"restore:core": "cd packages/ocwp-core && npm i",
		"restore:components": "cd packages/ocwp-components && npm i",
		"restore": "npm run restore:core && npm run restore:components && cd . && npm i",
		"restore_ci:core": "cd packages/ocwp-core && npm ci",
		"restore_ci:components": "cd packages/ocwp-components && npm ci",
		"restore_ci": "npm ci && npm run restore_ci:core && npm run restore_ci:components",
		"prune:core": "cd packages/ocwp-core && npm prune --production",
		"prune:components": "cd packages/ocwp-components && npm prune --production && rm node_modules/.cache -r -f",
		"prune": "npm run prune:core && npm run prune:components && cd . && npm prune --production && rm node_modules/.cache -r -f",
		"start": "node server.js --port 8080"
	},
	"files": [
		"cli",
		"deploy",
		"docs",
		"runtime",
		"packages",
		"index.js",
		"runner.js"
	],
	"dependencies": {
		"@babel/core": "7.15.0",
		"@babel/plugin-proposal-decorators": "7.16.7",
		"@babel/plugin-syntax-dynamic-import": "7.8.3",
		"@babel/plugin-transform-async-to-generator": "7.16.0",
		"@babel/preset-env": "7.15.0",
		"@babel/preset-typescript": "7.16.0",
		"@babel/runtime": "^7.12.0",
		"@instana/collector": "2.34.0",
		"@webpack-cli/serve": "1.6.0",
		"babel-loader": "8.2.2",
		"chalk": "4.1.0",
		"clean-webpack-plugin": "4.0.0-alpha.0",
		"command-line-args": "5.2.1",
		"commander": "7.2.0",
		"comment-json": "4.1.0",
		"copy-webpack-plugin": "9.0.1",
		"cors": "^2.8.5",
		"css-loader": "6.2.0",
		"enquirer": "2.3.6",
		"eslint": "7.4.0",
		"esm": "3.2.25",
		"express": "^4.18.2",
		"fs-extra": "9.1.0",
		"helmet-csp": "3.3.1",
		"html-webpack-plugin": "5.3.2",
		"mini-css-extract-plugin": "2.2.0",
		"prismjs": "1.23.0",
		"style-loader": "3.2.1",
		"terser-webpack-plugin": "5.2.5",
		"typescript": "4.4.4",
		"uuid": "8.3.2",
		"webpack": "5.54.0",
		"webpack-cli": "4.9.1",
		"webpack-dev-server": "3.11.2",
		"webpack-merge": "5.8.0",
		"workbox-webpack-plugin": "6.4.1"
	},
	"devDependencies": {
		"@pixi/jsdoc-template": "2.4.2",
		"@types/fs-extra": "8.1.0",
		"@types/node": "11.10.5",
		"@types/node-fetch": "2.1.6",
		"@types/shelljs": "0.8.3",
		"compression": "^1.7.4",
		"jsdoc": "3.6.3",
		"jsdoc-api": "5.0.4",
		"node-fetch": "2.3.0",
		"sort-paths": "1.1.1"
	}
}
