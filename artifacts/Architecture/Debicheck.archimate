        <element xsi:type="archimate:ApplicationInterface" name="Endpoint: GET landing" id="id-4dc079d3e4874251912e079e58e57e7d">
          <documentation>Loads the favourites landing screen&#xD;
/clientcare/favourites/v1/landing</documentation>
