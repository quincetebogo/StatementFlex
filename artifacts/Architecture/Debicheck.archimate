        <element xsi:type="archimate:ApplicationInterface" name="Endpoint: GET mandates" id="id-18536b936bec45778e9ad17dc0c0774d">
          <documentation>This endpoint is hit when navigating to the DebiCheck screen to load everything displayed on the DebiCheck screen. &#xD;
&#xD;
Full Endpoint Name: /clientcare/debicheck/v1/mandates</documentation>
          <property key="Endpoint Name" value="/clientcare/debicheck/v1/mandates"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Endpoint: GET approve" id="id-407092d7f5314b2daae9ea9bde856856"/>
        <element xsi:type="archimate:ApplicationInterface" name="Endpoint: POST decline" id="id-c8ace9915c40431ca764a3b5a13e281e">
          <documentation>/clientcare/debicheck/v1/client/{cifNumber}/mandate/{mandateId}/account/{debtorAccountNumber}/decline</documentation>
