        <element xsi:type="archimate:ApplicationInterface" name="Endpoint: GET details" id="id-d38ff8f5f7ec45ceb69cf451df6b7e11">
          <documentation>/clientcare/debicheck/v1/client/{cifNumber}/mandate/{mandateId}/register/{registerId}/details</documentation>
