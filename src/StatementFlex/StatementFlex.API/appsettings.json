{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrontendUrl": "https://capitecbank.co.za",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=58344;Database=statementflex;Username=myuser;Password=mypass"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "StatementFlex",
    "Audience": "StatementFlex",
    "ExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "AWSSettings":{
    "Region" :"eu-north-1",
    "BucketName" : "amzn-s3-statementflex",
    "AccessPointArn":"arn:aws:s3:eu-north-1:006631838565:accesspoint/statementflex-accesspoint"
  },
  "DownloadTokenSettings": {
    "ExpirationMinutes": 15,
    "MaxDownloadsPerToken": 1,
    "EnableIPValidation": false
  },
  "StatementProcessing": {
    "PageSize": 500,
    "InitialPageIndex": 0
  },
  "Cognito": {
    "UserPoolId": "eu-north-1_1FR6MvSCa",
    "Region": "eu-north-1",
    "ClientId": "41g2hvrft92h2ftv936btrvhno"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/StatementFlex-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
