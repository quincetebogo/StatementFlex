{
	"compilerOptions": {
		/* Visit https://aka.ms/tsconfig.json to read more about this file */
		/* Projects */
		/* Language and Environment */
		"experimentalDecorators": true, /* Enable experimental support for TC39 stage 2 draft decorators. */
		/* Modules */
		"baseUrl": "./", /* Specify the base directory to resolve non-relative module names. */
		"paths": {
			// Alias for "src" folder in project.
			"app/*": [
				"./src/*"
			],
			// Aliases for modules within "core", "elements" and "components".
			"platform/core": [
				"packages/ocwp-core/src/index"
			],
			"platform/elements": [
				"packages/ocwp-components/src/elements/index"
			],
			"platform/decorators": [
				"packages/ocwp-components/src/decorators/index"
			],
			"platform/elements/types": [
				"packages/ocwp-components/src/elements/types/index"
			],
			"platform/components": [
				"packages/ocwp-components/src/components/index"
			],
			"ocwp-core": [
				"packages/ocwp-core//src"
			],
			// Aliases for modules paths (DEPRECATED).
			"platform/Auditer": [
				"packages/ocwp-core/src/Auditer"
			],
			"platform/Configuration": [
				"packages/ocwp-core/src/Configuration"
			],
			"platform/EventAggregator": [
				"packages/ocwp-core/src/EventAggregator"
			],
			"platform/ExecutionContext": [
				"packages/ocwp-core/src/ExecutionContext"
			],
			"platform/HttpClient": [
				"packages/ocwp-core/src/HttpClient"
			],
			"platform/Logger": [
				"packages/ocwp-core/src/Logger"
			],
			"platform/NavigationContext": [
				"packages/ocwp-core/src/NavigationContext"
			],
			"platform/Platform": [
				"packages/ocwp-core/src/Platform"
			],
			"platform/Router": [
				"packages/ocwp-core/src/Router"
			],
			"platform/Security": [
				"packages/ocwp-core/src/Security"
			],
			"platform/SecurityContext": [
				"packages/ocwp-core/src/SecurityContext"
			],
			"platform/Utilities": [
				"packages/ocwp-core/src/Utilities"
			],
			// Exposed Libraries
			"chart.js": [
				"packages/ocwp-components/node_modules/chart.js"
			],
			"chartjs-plugin-datalabels": [
				"packages/ocwp-components/node_modules/chartjs-plugin-datalabels"
			],
			"luxon": [
				"packages/ocwp-core/node_modules/luxon"
			],
			"rxjs": [
				"packages/ocwp-core/node_modules/rxjs"
			],
			"uuid": [
				"packages/ocwp-core/node_modules/uuid"
			]
		}, /* Specify a set of entries that re-map imports to additional lookup locations. */
		/* JavaScript Support */
		"allowJs": true, /* Allow JavaScript files to be a part of your program. Use the `checkJS` option to get errors from these files. */
		/* Emit */
		"declaration": true, /* Generate .d.ts files from TypeScript and JavaScript files in your project. */
		"sourceMap": true, /* Create source map files for emitted JavaScript files. */
		"outDir": "lib", /* Specify an output folder for all emitted files. */
		/* Interop Constraints */
		"esModuleInterop": true, /* Emit additional JavaScript to ease support for importing CommonJS modules. This enables `allowSyntheticDefaultImports` for type compatibility. */
		"forceConsistentCasingInFileNames": true, /* Ensure that casing is correct in imports. */
		/* Type Checking */
		"strict": true, /* Enable all strict type-checking options. */
		/* Completeness */
		"skipLibCheck": true /* Skip type checking all .d.ts files. */
	},
	"include": [
		"src/**/*",
		"./runtime/types.d.ts"
	],
	"exclude": [
		"lib"
	]
}